datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  fullName  String
  avatarUrl String?
  role      String    @default("REGISTERED")
  campusId  String?
  campus    Campus?   @relation(fields: [campusId], references: [id])
  listings  Listing[]
  requests  BookRequest[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Campus {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  city        String
  state       String
  active      Boolean            @default(true)
  users       User[]
  inviteCodes CampusInviteCode[]
  listings    Listing[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("campuses")
}

model CampusInviteCode {
  id        String    @id @default(uuid())
  campusId  String
  campus    Campus    @relation(fields: [campusId], references: [id])
  codeHash  String    @unique
  maxUses   Int       @default(100)
  usedCount Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@map("campus_invite_codes")
}

model Listing {
  id             String         @id @default(uuid())
  donorId        String
  donor          User           @relation(fields: [donorId], references: [id])
  campusId       String
  campus         Campus         @relation(fields: [campusId], references: [id])
  title          String
  author         String
  isbn           String?
  edition        String?
  course         String?
  subject        String
  semester       String?
  condition      String         @default("GOOD")
  pickupLocation String
  description    String?
  status         String         @default("AVAILABLE")
  reservedUntil  DateTime?
  type           String         @default("DONATION")
  photos         ListingPhoto[]
  requests       BookRequest[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("listings")
}

model ListingPhoto {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("listing_photos")
}

model BookRequest {
  id            String    @id @default(uuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requesterId   String
  requester     User      @relation(fields: [requesterId], references: [id])
  message       String?
  status        String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, CANCELLED, COMPLETED
  reservedUntil DateTime?
  declineReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("book_requests")
}
