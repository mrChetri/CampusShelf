datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  fullName  String
  avatarUrl String?
  role      String    @default("REGISTERED")
  campusId           String?
  campus             Campus?       @relation(fields: [campusId], references: [id])
  listings           Listing[]
  requests           BookRequest[]
  donorHandovers     Handover[]    @relation("DonorHandovers")
  recipientHandovers Handover[]    @relation("RecipientHandovers")
  notifications      Notification[]
  status             String        @default("ACTIVE")
  reportsFiled       Report[]      @relation("ReporterReports")
  auditEvents        AuditEvent[]  @relation("ActorAuditEvents")
  proposedExchanges  ExchangeProposal[] @relation("ProposerExchanges")
  receivedExchanges  ExchangeProposal[] @relation("TargetOwnerExchanges")
  createdAt          DateTime      @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Campus {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  city        String
  state       String
  active      Boolean            @default(true)
  users       User[]
  inviteCodes CampusInviteCode[]
  listings    Listing[]
  partnerOrganizations PartnerOrganization[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("campuses")
}

model CampusInviteCode {
  id        String    @id @default(uuid())
  campusId  String
  campus    Campus    @relation(fields: [campusId], references: [id])
  codeHash  String    @unique
  maxUses   Int       @default(100)
  usedCount Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@map("campus_invite_codes")
}

model Listing {
  id             String         @id @default(uuid())
  donorId        String
  donor          User           @relation(fields: [donorId], references: [id])
  campusId       String
  campus         Campus         @relation(fields: [campusId], references: [id])
  title          String
  author         String
  isbn           String?
  edition        String?
  course         String?
  subject        String
  semester       String?
  condition      String         @default("GOOD")
  pickupLocation String
  description    String?
  status              String             @default("AVAILABLE")
  reservedUntil       DateTime?
  type                String             @default("DONATION")
  price               Int?
  exchangePreferences String?
  campaignNeedId      String?
  campaignNeed        CampaignNeed?      @relation(fields: [campaignNeedId], references: [id])
  photos              ListingPhoto[]
  requests            BookRequest[]
  handovers           Handover[]
  targetExchanges     ExchangeProposal[] @relation("TargetListing")
  offeredExchanges    ExchangeProposal[] @relation("OfferedListing")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("listings")
}

model ListingPhoto {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("listing_photos")
}

model BookRequest {
  id            String    @id @default(uuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requesterId   String
  requester     User      @relation(fields: [requesterId], references: [id])
  message       String?
  status        String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, CANCELLED, COMPLETED
  reservedUntil DateTime?
  declineReason String?
  handover      Handover?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("book_requests")
}

model Handover {
  id             String      @id @default(uuid())
  listingId      String
  listing        Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requestId      String      @unique
  request        BookRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donorId        String
  donor          User        @relation("DonorHandovers", fields: [donorId], references: [id])
  recipientId    String
  recipient      User        @relation("RecipientHandovers", fields: [recipientId], references: [id])
  pickupLocation String
  scheduleNotes  String?
  status         String      @default("SCHEDULED") // SCHEDULED, COMPLETED, DISPUTED, EXPIRED
  reservedUntil  DateTime
  completedAt    DateTime?
  disputedAt     DateTime?
  disputeReason  String?
  disputeDetails String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([listingId])
  @@index([donorId])
  @@index([recipientId])
  @@map("handovers")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  entityId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

model Report {
  id              String   @id @default(uuid())
  reporterId      String
  reporter        User     @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      String   // LISTING or USER
  targetId        String
  targetTitle     String?
  reason          String   // SPAM, INAPPROPRIATE, etc.
  details         String?
  status          String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  resolvedBy      String?
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("ActorAuditEvents", fields: [actorId], references: [id])
  actorName  String
  action     String   // HIDE_LISTING, UNHIDE_LISTING, SUSPEND_USER, UNSUSPEND_USER, RESOLVE_REPORT, DISMISS_REPORT
  targetType String   // LISTING or USER
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

model PartnerOrganization {
  id                 String    @id @default(uuid())
  name               String
  type               String    // CAMPUS_LIBRARY, COMMUNITY_LIBRARY, STUDENT_UNION, NGO
  description        String
  website            String?
  contactEmail       String
  contactPhone       String?
  address            String?
  campusId           String?
  campus             Campus?   @relation(fields: [campusId], references: [id])
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedAt         DateTime?
  adminReviewNotes   String?
  campaignNeeds      CampaignNeed[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([verificationStatus])
  @@index([campusId])
  @@map("partner_organizations")
}

model CampaignNeed {
  id                String              @id @default(uuid())
  partnerId         String
  partner           PartnerOrganization @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title             String
  category          String
  course            String?
  description       String?
  targetQuantity    Int
  fulfilledQuantity Int                 @default(0)
  status            String              @default("ACTIVE") // ACTIVE, FULFILLED, PAUSED
  urgent            Boolean             @default(false)
  listings          Listing[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([partnerId])
  @@index([status])
  @@map("campaign_needs")
}

model ExchangeProposal {
  id               String    @id @default(uuid())
  proposerId       String
  proposer         User      @relation("ProposerExchanges", fields: [proposerId], references: [id])
  targetOwnerId    String
  targetOwner      User      @relation("TargetOwnerExchanges", fields: [targetOwnerId], references: [id])
  targetListingId  String
  targetListing    Listing   @relation("TargetListing", fields: [targetListingId], references: [id], onDelete: Cascade)
  offeredListingId String
  offeredListing   Listing   @relation("OfferedListing", fields: [offeredListingId], references: [id], onDelete: Cascade)
  pickupLocation   String
  message          String?
  status           String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, COMPLETED, CANCELLED
  reservedUntil    DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([proposerId])
  @@index([targetOwnerId])
  @@index([targetListingId])
  @@index([offeredListingId])
  @@index([status])
  @@map("exchange_proposals")
}
